{
  "expo": {
    "name": "Minibot",
    "slug": "minibot",
    "version": "1.0.7",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "minibot",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.liuyidi.minibot",
      "buildNumber": "8",
      "infoPlist": {
        "CFBundleDisplayName": "Minibot",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.liuyidi.minibot",
      "versionCode": 8,
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "chatApiBaseUrl": "https://auth.liuyidi.me",
      "authApiBaseUrl": "https://auth.liuyidi.me",
      "minibotBaseUrl": "https://bot.liuyidi.me",
      "minibotAuthSecret": "",
      "router": {},
      "eas": {
        "projectId": "b5fd1beb-75bd-4bce-8bc6-78bd87ca03f4"
      }
    },
    "owner": "liuyidi"
  }
}
