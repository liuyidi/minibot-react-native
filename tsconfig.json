{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./src/*"],
      "@minibot/ui": ["./packages/ui/src/index.ts"],
      "@minibot/ui/*": ["./packages/ui/src/*"],
      "@mini-auth/auth-rn": ["../mini-auth/frontend/packages/auth-rn/src/index.ts"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
