{
  "name": "@minibot/ui",
  "version": "0.0.0",
  "private": true,
  "main": "lib/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "import": "./es/index.js",
      "require": "./lib/index.js",
      "types": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./lib/*": {
      "react-native": "./lib/*/index.js",
      "import": "./es/*/index.js",
      "require": "./lib/*/index.js",
      "default": "./lib/*/index.js"
    },
    "./es/*": {
      "import": "./es/*/index.js",
      "default": "./es/*/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "npm run storybook",
    "storybook": "npm run storybook --prefix ../..",
    "storybook:ios": "npm run storybook:ios --prefix ../..",
    "storybook:android": "npm run storybook:android --prefix ../..",
    "exports:gen": "node scripts/gen-exports.mjs --write",
    "exports:check": "node scripts/gen-exports.mjs --check",
    "build": "tsup && node scripts/write-babel-aliases.mjs",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@react-native-community/slider": "*",
    "lucide-react-native": "*",
    "react": "*",
    "react-native": "*",
    "react-native-gesture-handler": "*",
    "react-native-reanimated": "*",
    "react-native-root-siblings": "*",
    "react-native-safe-area-context": "*",
    "react-native-svg": "*"
  },
  "devDependencies": {
    "@react-native-community/slider": "5.2.0",
    "@types/react": "~19.1.0",
    "lucide-react-native": "^1.28.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-root-siblings": "^5.0.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "tsup": "^8.5.1",
    "typescript": "~5.9.2"
  },
  "sideEffects": false,
  "module": "es/index.js",
  "files": [
    "lib",
    "es",
    "src",
    "package.json",
    "README.md"
  ]
}
