{
  "name": "minibot",
  "main": "./index.tsx",
  "version": "1.0.7",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "lint": "expo lint",
    "version:bump": "node scripts/bump-version.js",
    "build:android:prebuild": "expo prebuild --platform android --no-install",
    "build:android:apk": "bash scripts/build-android-apk.sh",
    "eas:workflow:preview": "env -u HTTP_PROXY -u HTTPS_PROXY -u http_proxy -u https_proxy -u ALL_PROXY -u all_proxy npx eas workflow:run preview.yml",
    "eas:workflow:production": "env -u HTTP_PROXY -u HTTPS_PROXY -u http_proxy -u https_proxy -u ALL_PROXY -u all_proxy npx eas workflow:run production.yml",
    "install:deps": "bash scripts/npm-with-github-auth.sh install",
    "setup:github-packages": "bash scripts/setup-github-packages.sh",
    "sync:tokens": "node scripts/sync-design-tokens.mjs"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@mini-auth/auth-rn": "file:../mini-auth/frontend/packages/auth-rn",
    "@minibot/client": "npm:@liuyidi/minibot-client@1.0.16",
    "@minibot/ui": "file:./packages/ui",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.17",
    "expo-blur": "~57.0.2",
    "expo-build-properties": "~57.0.17",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.17",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.2",
    "expo-linking": "~57.0.9",
    "expo-router": "~57.0.20",
    "expo-secure-store": "~57.0.3",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-web-browser": "~57.0.2",
    "lucide-react-native": "^1.28.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-get-random-values": "^1.11.0",
    "react-native-gifted-chat": "^2.6.5",
    "react-native-markdown-display": "^7.0.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@expo/ngrok": "^4.1.3",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.2.4",
    "@types/react-test-renderer": "^19.1.0",
    "jest": "^29.2.1",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "private": true
}
